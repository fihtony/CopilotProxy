# Database configuration
# Path where the SQLite database will be stored
# Default: ./data/copilot-proxy.db (relative to project root)
DATABASE_PATH=./data/copilot-proxy.db

# Client server port, Client API (OpenAI-compatible proxy, requires API key)
CLIENT_PORT=8022

# Admin server port, Admin API (for the dashboard UI)
ADMIN_PORT=8020

# UI server port
UI_PORT=3020

# Copilot Connect backend configuration
# Only used during database initialization to set the default copilot_url in settings
# After initialization, the proxy uses the url from the settings table in the database
# Can be changed in the Settings page UI
COPILOT_URL=http://127.0.0.1:1288

# Upstream request timeout in milliseconds
# Default: 300000 ms (5 minutes)
# Used for both streaming and non-streaming requests to prevent indefinite hangs
# if the upstream connection is stalled or lost
# Note: Active data transfers reset the idle timer, so long streaming responses are unaffected
PROXY_TIMEOUT_MS=300000

# Default model for new API keys
# Only used during database initialization to set the default_model in settings
# After initialization, users can change this in the Settings page UI
DEFAULT_MODEL=gpt-5-mini

# ── Security: dev-mode auth bypass ─────────────────────────────────────────
# REQUIRED when running in dev mode (NODE_ENV !== production).
# Without this flag the admin API (/api/admin/*) will require a valid
# Cloudflare Access JWT on every request, even in dev.
#
# This value is READ DIRECTLY FROM THIS FILE on every write operation
# (create/edit/delete key, update settings). Setting the env var at the
# shell level is intentionally insufficient — it must be present here.
#
# DO NOT set this in production. It has no effect when NODE_ENV=production.
LOCAL_BYPASS_OAUTH_ALLOWED=false

